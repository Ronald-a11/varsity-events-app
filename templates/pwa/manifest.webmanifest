{
  "name": "{{ SITE_NAME }}",
  "short_name": "{{ SITE_NAME_LEAD|title }}",
  "description": "{{ SITE_TAGLINE }}",
  "start_url": "{{ start_url }}",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b14",
  "theme_color": "#4f46e5",
  "lang": "en-ZW",
  "categories": ["events", "education", "social"],
  "icons": [
    {% if icon_192 %}{
      "src": "{{ icon_192 }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },{% endif %}
    {% if icon_512 %}{
      "src": "{{ icon_512 }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },{% endif %}
    {% if icon_maskable %}{
      "src": "{{ icon_maskable }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }{% endif %}
  ],
  "shortcuts": [
    {
      "name": "My tickets",
      "short_name": "Tickets",
      "description": "The one thing that has to work at a door with no signal",
      "url": "{{ tickets_url }}"
    },
    {
      "name": "What's on",
      "short_name": "Discover",
      "url": "{{ discover_url }}"
    }
  ]
}
