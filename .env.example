# Copy to .env and adjust for your environment.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Harare

# Only used when DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=True

# Email. Leave EMAIL_HOST blank and mail prints to the console instead of
# sending — handy in development, and it means a misconfigured deploy logs
# rather than failing every time a ticket is confirmed.
# Verify with: python manage.py check_email --to you@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Varsity Events <no-reply@varsityevents.app>

# Links inside emails are built from this — there's no request to derive it from.
# On Railway it defaults to the assigned domain.
SITE_BASE_URL=http://localhost:8000

# Pesepay — the online gateway. Both keys are in your merchant dashboard.
# The encryption key is exactly 32 characters.
# Leave blank to run the built-in checkout simulator instead of live payments.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
# Method codes for your account, if they differ from the defaults.
PESEPAY_CODE_ECOCASH=PZW201
PESEPAY_CODE_ONEMONEY=PZW204
PESEPAY_CODE_INNBUCKS=PZW211

# Paynow — legacy gateway, kept so pre-switch payments can still settle.
# Real values belong in .env, never in this template.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# Direct EcoCash collection — money lands straight in this wallet.
ECOCASH_MERCHANT_NUMBER=07XXXXXXXX
ECOCASH_MERCHANT_NAME=Varsity Events
ECOCASH_DIRECT_ENABLED=True
ECOCASH_DIRECT_HOLD_MINUTES=120

# --- Platform fee -----------------------------------------------------------
# What we keep from each ticket we sell on a society's behalf. Both default to
# zero, so an existing deployment takes no fee until you say otherwise.
#
# The fee is worked out and FROZEN onto each payment the moment it settles, so
# changing these never restates what a society was already owed. What is left
# after the fee is what /pay/payouts/ says we owe them.
PLATFORM_FEE_PERCENT=0
PLATFORM_FEE_FIXED=0


# --- Infrastructure ---------------------------------------------------
#
# Everything below is optional. Leave it blank and the app runs exactly as it
# did before any of it existed: local-memory cache, tasks inline, uploads on
# the local disk, logs to stderr, no error reporting.

# Redis. Backs the shared cache and the task cluster. Without it the login
# throttle counts per worker process rather than per person, and mail is sent
# inside the request that triggered it.
# Railway: add a Redis service and it injects this.
REDIS_URL=

# Background tasks. Off by default: a queue with no worker behind it accepts
# jobs and silently never runs them, so turn this on in the same change that
# starts the worker, never before. Left off, every task runs inline.
#
#   DJANGO_TASKS_ASYNC=True   and   python manage.py qcluster
#
# The queue rides on Redis when REDIS_URL is set, and on the database when it
# isn't — so this doesn't require Redis, it just prefers it.
DJANGO_TASKS_ASYNC=False
Q_WORKERS=2

# Postgres connection pooling. Off by default — it needs max_connections
# headroom, and Django won't allow it alongside persistent connections.
DJANGO_DB_POOL=False
DJANGO_DB_POOL_MIN=2
DJANGO_DB_POOL_MAX=8

# Object storage for uploaded posters and society logos. A container's disk is
# rebuilt on every deploy, so without either this or a mounted volume every
# image uploaded since the last deploy is gone. S3-compatible: the same four
# variables work for Cloudflare R2, Backblaze B2 and DigitalOcean Spaces.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# A CDN or custom domain in front of the bucket, if there is one.
AWS_S3_CUSTOM_DOMAIN=

# Logging. json in production so the lines can be searched, console in
# development so they can be read. DJANGO_LOG_SQL prints every query — how you
# find an N+1, unbearable the rest of the time.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=console
DJANGO_LOG_SQL=False

# Error reporting. Inert without a DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Per-view throttling. Only turn this off to debug a limit you think is wrong.
DJANGO_RATELIMIT_ENABLE=True

# How often the status page may make us ask a payment gateway about one
# transaction. The page polls on a timer; without a floor here every tick was an
# outbound call. Local state still updates on every poll, so a payment confirmed
# by callback is noticed immediately — only the network call is rationed.
PAYMENT_POLL_MIN_SECONDS=4

# Web Push. Generate a pair with:  python manage.py make_vapid_keys
#
# Keep them stable once set. A browser ties its subscription to the key that
# created it, so rotating the pair silently invalidates every permission anybody
# has granted — and a granted permission is never asked for again. Leave blank
# and push is a no-op; nothing else changes and no dead button is shown.
# Both are single-line base64url, exactly as make_vapid_keys prints them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@varsityevents.app

# Two-factor is always enforced on the views that can release money — see
# accounts/twofactor.py. An account without a device is redirected to set one
# up, never refused, so it can't lock anybody out.
#
# Django's own admin is separate, and off by default on purpose: turning it on
# with no enrolled superuser locks the only account that could fix it out of
# the only place it could be fixed. Enrol first, then set this.
DJANGO_ADMIN_REQUIRE_2FA=False

# Reading an event off its poster (organizers and staff only).
#
# A campus event here IS a poster in a WhatsApp group; this reads one and
# pre-fills the create-event form so the society checks the details rather than
# retyping them. Nothing is saved automatically — the organizer still reviews
# and submits, and the event still goes through the usual moderation.
#
# Leave the key blank and the feature hides itself; the ordinary form is
# unchanged. Roughly 2 US cents per poster.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Lets an outside scheduler run the recurring jobs, for deployments with no
# room for a task cluster of its own. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Give the same value to the scheduler. Blank, and /tasks/run/ 404s like any
# other unknown URL. See .github/workflows/scheduled-jobs.yml.
TASK_TOKEN=
